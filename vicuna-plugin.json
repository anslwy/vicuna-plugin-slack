    "setupSteps": [
      {
        "text": "Open Slack API Apps → Create New App → From a manifest (not From scratch):",
        "linkText": "Slack API Apps",
        "linkUrl": "https://api.slack.com/apps"
      },
      {
        "text": "Paste the Manifest YAML (sets up DMs, scopes, events, Socket Mode & Interactivity automatically) from the",
